# Local API
NODE_ENV=development
PORT=3000
# SQLite paths are relative to apps/api.
DATABASE_URL=file:./dev.db
# IANA timezone that decides which calendar day counts as today.
APP_TIMEZONE=UTC

# Test environment must use a separate database file named test.db.
TEST_DATABASE_URL=file:./test.db
ENABLE_TEST_UTILITIES=false

# Web API base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Mobile API base URL:
# Use your development machine's LAN IP for physical devices.
# Android emulator commonly reaches host machine via 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
